{
  "expo": {
    "name": "Majlis al-Bararah",
    "slug": "majlis-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "majlisalbararah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.majlisalbararah.app",
      "supportsTablet": false,
      "infoPlist": {
        "ExpoLocalization_supportsRTL": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d3527",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.majlisalbararah.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d3527",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "To show the prayer times and the qibla for where you are. يُستعمل موقعك لمواقيت الصلاة واتجاه القبلة."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": false,
      "eas": {
        "projectId": "04105dee-0519-4e41-9d5c-84e296f842dc"
      }
    },
    "owner": "gitnouras-team"
  }
}
